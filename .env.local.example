# --- Render の Environment にコピーする値（.env.local はコミットしない）---

# ログイン画面「パスワードをお忘れの方」に表示する連絡先
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=you@example.com

# Supabase（ダッシュボード → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# サーバー専用（ブラウザに出さない）。未解決BOXの status 同期などで使用
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# OpenAI（チャット・埋め込み）
OPENAI_API_KEY=sk-your-openai-api-key

# ElevenLabs（読み上げ TTS。未設定だと TTS 系 API はエラーになる）
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
